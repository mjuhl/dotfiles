# ghostty +show-config --default --docs
# ghostty +list-themes

# === font ===
# font-family= "Symbols Nerd Font Mono"
font-family= "SauceCodePro Nerd Font"
# font-family= CommitMono Nerd Font

# To disable programming ligatures, use -calt
font-feature= -calt

# Font size in points. For example, 13.5pt @ 2px/pt = 27px. Must restart.
font-size= 12


# === look and feel ===

# theme= catppuccin-mocha
# theme= vesper
# theme= "Kanagawa Dragon"
theme= "darcubox"
# background-opacity = 0.95
background-blur-radius = 20
# macos-titlebar-style= transparent
macos-titlebar-style= hidden
macos-titlebar-proxy-icon = hidden

window-padding-x = 8
window-padding-y = 8

# === behavior ===

# left option key will be treated as "alt"
macos-option-as-alt= left
desktop-notifications= true
mouse-hide-while-typing= true
shell-integration-features = sudo

# === keybinds ===
keybind= super+shift+up=scroll_page_lines:-1
keybind= super+shift+down=scroll_page_lines:1
#keybind= super+shift+down=scroll_down

